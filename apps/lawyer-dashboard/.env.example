# Lawyer Dashboard — Environment Variables
# Copy this file to .env and set values. .env is git-ignored.
# See docs/environment-reference.md for the complete variable reference.

# ── API Base URL ──────────────────────────────────────
# VITE_API_BASE_URL (required) — Base URL for the backend API. Format: https://domain.com/api/v1
# Local Docker development: http://localhost:8976/api/v1
# Local dotnet run:         http://localhost:8977/api/v1
# Production:               https://api.yourdomain.com/api/v1 (MUST be HTTPS — enforced at runtime in prod builds)
VITE_API_BASE_URL=http://localhost:8976/api/v1

# ── Sentry Error Monitoring ──────────────────────────
# VITE_SENTRY_DSN (optional) — Sentry error monitoring DSN. Format: https://key@sentry.io/project. Leave empty to disable.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
