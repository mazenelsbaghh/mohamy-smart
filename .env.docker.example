# ── Local Docker Environment ──────────────────────────────────────
# Copy this file to .env.docker and fill in real values.
# .env.docker is git-ignored — never commit secrets.
# See docs/environment-reference.md for the complete variable reference.
# ──────────────────────────────────────────────────────────────────

# ── Database (REQUIRED) ───────────────────────────────────────────
# SA password for the local SQL Server container
MSSQL_SA_PASSWORD=YourStrong!Passw0rd
ConnectionStrings__SqlServer=Server=sqlserver,1433;Database=Lawyer;User Id=sa;Password=YourStrong!Passw0rd;Encrypt=True;TrustServerCertificate=True;

# ── Backend Base URL (REQUIRED) ───────────────────────────────────
AppSetting__BaseUrl=http://localhost:8976

# ── JWT / Authentication (REQUIRED) ──────────────────────────────
JWT__Key=local-docker-jwt-secret-key-32-characters-minimum
DataProtection__KeysPath=/app/DataProtectionKeys

# ── AI Providers (OPTIONAL for local boot) ───────────────────────
# Placeholder values allow the backend to start in Development.
# Features that call these providers need real keys.
OpenAI__ApiKey=YOUR_OPENAI_API_KEY
Gemini__ApiKey=YOUR_GEMINI_API_KEY
GoogleVision__ApiKey=YOUR_GOOGLE_VISION_API_KEY

# ── Paymob Payment Integration (OPTIONAL for local boot) ─────────
# Placeholder values allow the backend to start in Development.
# Payment flows need real keys.
Paymob__APIKey=YOUR_PAYMOB_API_KEY
Paymob__SecretKey=YOUR_PAYMOB_SECRET_KEY
Paymob__PublicKey=YOUR_PAYMOB_PUBLIC_KEY
Paymob__HMAC=YOUR_PAYMOB_HMAC_SECRET
Paymob__CardIntegrationId=YOUR_CARD_INTEGRATION_ID
Paymob__MobileIntegrationId=YOUR_MOBILE_INTEGRATION_ID
Paymob__CallbackBaseUrl=http://localhost:8976

# ── CORS & Frontend URLs (REQUIRED) ─────────────────────────────
FrontendBaseUrl=http://localhost:5078
CorsOrigins__0=http://localhost:5078
CorsOrigins__1=http://localhost:5079
CorsOrigins__2=http://localhost:3000

# ── Email Delivery (OPTIONAL for local dev) ──────────────────────
# Leave placeholder values to skip email features during local development
EmailSettings__SmtpHost=smtp.example.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser=YOUR_EMAIL_USERNAME
EmailSettings__SmtpPassword=YOUR_EMAIL_PASSWORD
EmailSettings__FromAddress=noreply@example.com
EmailSettings__FromName=محامي سمارت
EmailSettings__UseSsl=true

# ── SMS Delivery (Plus SMS — Egypt) ───────────────────────────────
SmsSettings__BaseUrl=https://plus.smssmartegypt.com/api/PlusSMS/SendSMS
SmsSettings__Username=YOUR_SMS_USERNAME
SmsSettings__Password=YOUR_SMS_PASSWORD
SmsSettings__SenderName=MohamySmart
SmsSettings__Enabled=true

# ── Sentry Error Monitoring (OPTIONAL) ────────────────────────────
Sentry__Dsn=
Sentry__Environment=local-docker
Sentry__TracesSampleRate=0.2

# ── ClamAV Antivirus (REQUIRED) ───────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_STRICT=false
