# ── Production Docker Environment ─────────────────────────────────
# Copy this file to .env.docker.prod and fill in real values.
# .env.docker.prod is git-ignored — never commit secrets.
# See docs/environment-reference.md for the complete variable reference.
# ──────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════
#  REQUIRED PRODUCTION SECRETS
# ══════════════════════════════════════════════════════════════════

# ── Database (REQUIRED) ───────────────────────────────────────────
ConnectionStrings__SqlServer=Server=YOUR_DB_HOST,1433;Database=Lawyer;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Encrypt=True;TrustServerCertificate=True;

# ── JWT / Authentication (REQUIRED) ──────────────────────────────
JWT__Key=CHANGE_ME_to_a_random_32_char_string__

# ── AI Providers (REQUIRED for production) ───────────────────────
OpenAI__ApiKey=YOUR_OPENAI_API_KEY
Gemini__ApiKey=YOUR_GEMINI_API_KEY

# ── Paymob Payment Integration (REQUIRED for production) ─────────
Paymob__APIKey=YOUR_PAYMOB_API_KEY
Paymob__SecretKey=YOUR_PAYMOB_SECRET_KEY
Paymob__PublicKey=YOUR_PAYMOB_PUBLIC_KEY
Paymob__HMAC=YOUR_PAYMOB_HMAC_SECRET
Paymob__CardIntegrationId=YOUR_CARD_INTEGRATION_ID
Paymob__MobileIntegrationId=YOUR_MOBILE_INTEGRATION_ID
Paymob__CallbackBaseUrl=https://api.mohamy-smart.com

# ── Email Delivery (REQUIRED for production) ─────────────────────
EmailSettings__SmtpHost=smtp.example.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUser=YOUR_EMAIL_USERNAME
EmailSettings__SmtpPassword=YOUR_EMAIL_PASSWORD
EmailSettings__FromAddress=noreply@yourdomain.com
EmailSettings__FromName=محامي سمارت
EmailSettings__UseSsl=true

# ── SMS Delivery (REQUIRED for production) ──────────────────────
SmsSettings__BaseUrl=YOUR_SMS_PROVIDER_URL
SmsSettings__Username=YOUR_SMS_USERNAME
SmsSettings__Password=YOUR_SMS_PASSWORD
SmsSettings__SenderName=MohamySmart
SmsSettings__Enabled=true

# ══════════════════════════════════════════════════════════════════
#  REQUIRED PUBLIC URLS
# ══════════════════════════════════════════════════════════════════

# ── Backend Base URL (REQUIRED) ──────────────────────────────────
AppSetting__BaseUrl=https://api.mohamy-smart.com

# ── CORS & Frontend URLs (REQUIRED) ─────────────────────────────
FrontendBaseUrl=https://lawyer.mohamy-smart.com
CorsOrigins__0=https://lawyer.mohamy-smart.com
CorsOrigins__1=https://admin.mohamy-smart.com
CorsOrigins__2=https://mohamy-smart.com

# ── Frontend Build-Time API URLs (REQUIRED) ──────────────────────
# Used as build args in docker-compose.prod.yml
VITE_LAWYER_API_URL=https://api.mohamy-smart.com/api/v1
VITE_ADMIN_API_URL=https://api.mohamy-smart.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://api.mohamy-smart.com/api/v1
NEXT_PUBLIC_DASHBOARD_URL=https://lawyer.mohamy-smart.com

# ── Frontend Public App URLs (informational, used by nginx / CORS) ──
LAWYER_DASHBOARD_URL=https://lawyer.mohamy-smart.com
ADMIN_DASHBOARD_URL=https://admin.mohamy-smart.com
LANDING_URL=https://mohamy-smart.com

# ══════════════════════════════════════════════════════════════════
#  OPTIONAL MONITORING
# ══════════════════════════════════════════════════════════════════

# ── Sentry Error Monitoring (optional but recommended) ───────────
Sentry__Dsn=YOUR_SENTRY_DSN
Sentry__Environment=production
Sentry__TracesSampleRate=0.2

# ── Frontend Sentry (optional, build-time) ───────────────────────
# Uncomment and set DSNs to enable frontend error monitoring in production
# VITE_LAWYER_SENTRY_DSN=YOUR_LAWYER_SENTRY_DSN
# VITE_LAWYER_SENTRY_ENVIRONMENT=production
# VITE_ADMIN_SENTRY_DSN=YOUR_ADMIN_SENTRY_DSN
# VITE_ADMIN_SENTRY_ENVIRONMENT=production

# ══════════════════════════════════════════════════════════════════
#  OPTIONAL PORT OVERRIDES
# ══════════════════════════════════════════════════════════════════
# Uncomment to override default ports
# BACKEND_PORT=8976
# LAWYER_PORT=5078
# ADMIN_PORT=5079
# LANDING_PORT=3000
